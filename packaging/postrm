#!/bin/sh
set -e

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
  systemctl stop com.vortex.helper.service >/dev/null 2>&1 || true
  systemctl disable com.vortex.helper.service >/dev/null 2>&1 || true
  rm -f /etc/systemd/system/com.vortex.helper.service
  systemctl daemon-reload >/dev/null 2>&1 || true
fi

exit 0
