#!/bin/sh
set -eu

if [ "$(id -u)" -ne 0 ]; then
  echo "lantianyun-service-helper must run as root" >&2
  exit 1
fi

action="${1:-}"
core_path="${2:-}"
config_dir="${3:-}"
config_file="${4:-}"
controller="${5:-127.0.0.1:39798}"
unit_name="com.vortex.helper.service"
unit_path="/etc/systemd/system/$unit_name"

validate_path() {
  case "$1" in
    *$'\n'*|*$'\r'*|*'"'*)
      echo "Unsupported character in path" >&2
      exit 2
      ;;
  esac
}

case "$action" in
  install|update|uninstall)
    validate_path "$core_path"
    validate_path "$config_dir"
    validate_path "$config_file"
    ;;
  *)
    echo "Usage: $0 install|update|uninstall <core> <config-dir> <config-file> <controller>" >&2
    exit 2
    ;;
esac

if [ "$action" = "uninstall" ]; then
  systemctl stop "$unit_name" >/dev/null 2>&1 || true
  systemctl disable "$unit_name" >/dev/null 2>&1 || true
  rm -f "$unit_path"
  systemctl daemon-reload
  exit 0
fi

if [ ! -x "$core_path" ]; then
  echo "Core is missing or not executable: $core_path" >&2
  exit 3
fi
if [ ! -f "$config_file" ]; then
  echo "Config is missing: $config_file" >&2
  exit 4
fi
if [ ! -e /dev/net/tun ]; then
  echo "/dev/net/tun is unavailable on this system" >&2
  exit 5
fi

tmp_unit="$(mktemp)"
trap 'rm -f "$tmp_unit"' EXIT INT TERM
cat >"$tmp_unit" <<EOF
[Unit]
Description=蓝天云 Mihomo service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart="$core_path" -d "$config_dir" -f "$config_file" -ext-ctl "$controller"
Restart=on-failure
RestartSec=2s
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
EOF

install -m 0644 "$tmp_unit" "$unit_path"
systemctl daemon-reload
systemctl enable "$unit_name" >/dev/null
systemctl restart "$unit_name"
